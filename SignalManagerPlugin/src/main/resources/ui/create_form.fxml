<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<AnchorPane fx:controller="com.example.signalmanager.ui.CreateFormController" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <BorderPane AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">
      <top>
        <ToolBar>
          <items>
            <Button text="%signalmanager.btn.save" onAction="#onSave"/>
            <Button text="%signalmanager.btn.cancel" onAction="#onCancel"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label text="%signalmanager.id"/>
            <Label fx:id="idValue" style="-fx-font-weight: bold;"/>
          </items>
        </ToolBar>
      </top>

      <center>
        <ScrollPane fitToWidth="true">
          <content>
            <VBox spacing="12.0" padding="12">
              <!-- Основное -->
              <TitledPane text="%signalmanager.group.main" expanded="true">
                <content>
                  <GridPane hgap="8" vgap="8" padding="8">
                    <columnConstraints>
                      <ColumnConstraints halignment="RIGHT" prefWidth="200"/>
                      <ColumnConstraints halignment="LEFT" hgrow="ALWAYS"/>
                    </columnConstraints>
                    <children>
                      <Label text="%signalmanager.name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                      <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                      <Label text="%signalmanager.size" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                      <HBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <children>
                          <Spinner fx:id="sizeField" prefWidth="120"/>
                          <Button text="%signalmanager.btn.random" onAction="#onRandomSize"/>
                        </children>
                      </HBox>

                      <Label text="%signalmanager.type" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                      <ComboBox fx:id="typeCombo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    </children>
                  </GridPane>
                </content>
              </TitledPane>

              <!-- Флаги -->
              <TitledPane text="%signalmanager.group.flags" expanded="true">
                <content>
                  <HBox spacing="12" padding="8">
                    <children>
                      <CheckBox fx:id="specialResponseCheck" text="%signalmanager.special_response"/>
                      <CheckBox fx:id="specialPriceCheck" text="%signalmanager.special_price"/>
                    </children>
                  </HBox>
                </content>
              </TitledPane>

              <!-- Изображения -->
              <TitledPane text="%signalmanager.group.images" expanded="true">
                <content>
                  <GridPane hgap="8" vgap="8" padding="8">
                    <columnConstraints>
                      <ColumnConstraints halignment="RIGHT" prefWidth="200"/>
                      <ColumnConstraints halignment="LEFT" hgrow="ALWAYS"/>
                    </columnConstraints>
                    <children>
                      <Label text="%signalmanager.object_image" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                      <AnchorPane fx:id="objectImagePane" GridPane.rowIndex="0" GridPane.columnIndex="1" prefHeight="28"/>

                      <Label text="%signalmanager.image_raw" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                      <AnchorPane fx:id="imageRawPane" GridPane.rowIndex="1" GridPane.columnIndex="1" prefHeight="28"/>

                      <Label text="%signalmanager.image_low" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                      <AnchorPane fx:id="imageLowPane" GridPane.rowIndex="2" GridPane.columnIndex="1" prefHeight="28"/>

                      <Label text="%signalmanager.image_noisy" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                      <AnchorPane fx:id="imageNoisyPane" GridPane.rowIndex="3" GridPane.columnIndex="1" prefHeight="28"/>

                      <Label text="%signalmanager.image_high" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                      <AnchorPane fx:id="imageHighPane" GridPane.rowIndex="4" GridPane.columnIndex="1" prefHeight="28"/>
                    </children>
                  </GridPane>
                </content>
              </TitledPane>

              <!-- Звуки -->
              <TitledPane text="%signalmanager.group.sounds" expanded="true">
                <content>
                  <GridPane hgap="8" vgap="8" padding="8">
                    <columnConstraints>
                      <ColumnConstraints halignment="RIGHT" prefWidth="200"/>
                      <ColumnConstraints halignment="LEFT" hgrow="ALWAYS"/>
                    </columnConstraints>
                    <children>
                      <Label text="%signalmanager.sound_raw" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                      <AnchorPane fx:id="soundRawPane" GridPane.rowIndex="0" GridPane.columnIndex="1" prefHeight="28"/>

                      <Label text="%signalmanager.sound_low" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                      <AnchorPane fx:id="soundLowPane" GridPane.rowIndex="1" GridPane.columnIndex="1" prefHeight="28"/>

                      <Label text="%signalmanager.sound_noisy" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                      <AnchorPane fx:id="soundNoisyPane" GridPane.rowIndex="2" GridPane.columnIndex="1" prefHeight="28"/>

                      <Label text="%signalmanager.sound_high" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                      <AnchorPane fx:id="soundHighPane" GridPane.rowIndex="3" GridPane.columnIndex="1" prefHeight="28"/>
                    </children>
                  </GridPane>
                </content>
              </TitledPane>

              <!-- Цены -->
              <TitledPane text="%signalmanager.group.prices" expanded="false">
                <content>
                  <VBox fx:id="pricesBox" spacing="8" padding="8">
                    <children>
                      <HBox spacing="10"><children><Label text="%signalmanager.price_raw"/><TextField fx:id="priceRawField" prefWidth="120"/></children></HBox>
                      <HBox spacing="10"><children><Label text="%signalmanager.price_low"/><TextField fx:id="priceLowField" prefWidth="120"/></children></HBox>
                      <HBox spacing="10"><children><Label text="%signalmanager.price_noisy"/><TextField fx:id="priceNoisyField" prefWidth="120"/></children></HBox>
                      <HBox spacing="10"><children><Label text="%signalmanager.price_high"/><TextField fx:id="priceHighField" prefWidth="120"/></children></HBox>
                    </children>
                  </VBox>
                </content>
              </TitledPane>

              <!-- Тексты -->
              <TitledPane text="%signalmanager.group.texts" expanded="true">
                <content>
                  <GridPane hgap="8" vgap="8" padding="8">
                    <columnConstraints>
                      <ColumnConstraints halignment="RIGHT" prefWidth="200"/>
                      <ColumnConstraints halignment="LEFT" hgrow="ALWAYS"/>
                    </columnConstraints>
                    <children>
                      <Label text="%signalmanager.text_raw" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                      <TextField fx:id="textRawField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                      <Label text="%signalmanager.text_low" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                      <TextField fx:id="textLowField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                      <Label text="%signalmanager.text_noisy" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                      <TextField fx:id="textNoisyField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                      <Label text="%signalmanager.text_high" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                      <TextField fx:id="textHighField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </children>
                  </GridPane>
                </content>
              </TitledPane>

              <!-- Спец-ответы -->
              <TitledPane text="%signalmanager.group.sr" expanded="false">
                <content>
                  <VBox fx:id="specialResponsesBox" spacing="8" padding="8">
                    <children>
                      <HBox spacing="10"><children><Label text="%signalmanager.sr_raw"/><TextField fx:id="srRawField" prefWidth="400"/></children></HBox>
                      <HBox spacing="10"><children><Label text="%signalmanager.sr_low"/><TextField fx:id="srLowField" prefWidth="400"/></children></HBox>
                      <HBox spacing="10"><children><Label text="%signalmanager.sr_noisy"/><TextField fx:id="srNoisyField" prefWidth="400"/></children></HBox>
                      <HBox spacing="10"><children><Label text="%signalmanager.sr_high"/><TextField fx:id="srHighField" prefWidth="400"/></children></HBox>
                    </children>
                  </VBox>
                </content>
              </TitledPane>

            </VBox>
          </content>
        </ScrollPane>
      </center>
    </BorderPane>
  </children>
</AnchorPane>
